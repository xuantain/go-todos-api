# Stage 1: Build the Go application
FROM golang:1.25-alpine AS builder

WORKDIR /go/src/app

# Pre-cache deps
COPY ./app ./

RUN go mod download

RUN CGO_ENABLED=0 GOOS=linux go build -o /go/bin/app

# Stage 2: Run with nginx as reverse proxy
FROM alpine:3.20

# Install nginx and ca-certificates
RUN apk add --no-cache nginx ca-certificates

WORKDIR /go/bin/

# Copy the compiled binary
COPY --from=builder /go/bin/app /go/bin/app

# Copy nginx config
COPY ./docker/nginx/nginx.conf /etc/nginx/nginx.conf

# Use a shell script to start both nginx and the Go app so that:
# - both processes run together
# - the container stays alive as long as the Go app runs
# COPY ./docker/images/start.sh /start.sh
# # Need to set permission on host machine also
# RUN chmod +x /start.sh

# Create a non-root user
# RUN adduser -D -h /home/webuser -u 1001 -s /sbin/nologin webuser

# RUN chown -R webuser:webuser /go && \
#     chmod -R 755 /go && \
#     chown webuser:webuser /start.sh && \
#     # nginx needs to write pid and logs
#     chown -R webuser:webuser /var/log/nginx /var/lib/nginx /run/nginx 2>/dev/null || \
#     chown -R webuser:webuser /var/log/nginx && \
#     mkdir -p /tmp/nginx && chown webuser:webuser /tmp/nginx

# USER webuser

EXPOSE 8080 80

CMD ["/go/bin/app"]
